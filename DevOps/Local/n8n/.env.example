# Copy to .env and keep .env out of git.
# Generate a stable key once, then never change it (credentials depend on it):
#   openssl rand -hex 24

N8N_ENCRYPTION_KEY=replace-with-a-stable-32-plus-char-secret

# Local owner account (auto-created by n8n-start.sh — skips /setup)
N8N_OWNER_EMAIL=admin@localhost.local
N8N_OWNER_PASSWORD=LocalDev123!
N8N_OWNER_FIRST_NAME=Local
N8N_OWNER_LAST_NAME=Admin
